# ==========================================
# UZHAVAN 360 - SERVER ENVIRONMENT CONFIGURATION
# ==========================================

# --- APPLICATION CORE ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- DATABASE (MONGODB ATLAS) ---
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/uzhavan360?retryWrites=true&w=majority
# Or local dev: mongodb://127.0.0.1:27017/uzhavan360
MONGODB_URI=mongodb://127.0.0.1:27017/uzhavan360

# --- AUTHENTICATION (JWT) ---
JWT_SECRET=uzhavan360_development_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# --- CLOUDINARY (MEDIA STORAGE) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- UZHAVAN AI LAYER (GEMINI LLM) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
AI_API_KEY=your_gemini_api_key

# --- VOICE / SPEECH LAYER ---
# STT providers: whisper | mock
STT_PROVIDER=mock
# TTS providers: google | mock
TTS_PROVIDER=mock
