# ==============================================================================
# UZHAVAN 360 — MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Level 1 Architecture Reference & Level 2 Configuration Management
#
# Instructions:
# 1. Copy this file or configure server/.env and client/.env accordingly.
# 2. Never commit real credentials, passwords, or production keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (server/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database — MongoDB Atlas Connection URI
# e.g., mongodb+srv://<dbuser>:<dbpass>@cluster0.mongodb.net/uzhavan360?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/uzhavan360

# Authentication — JSON Web Token Secret & Expiration
JWT_SECRET=replace_with_a_secure_random_64_char_secret_in_production
JWT_EXPIRES_IN=7d

# Media Storage — Cloudinary Integration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Uzhavan AI Assistant — Google Gemini LLM Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
AI_API_KEY=your_gemini_api_key

# Multilingual Voice Processing (Tamil / English / Tanglish)
# STT options: whisper | mock
STT_PROVIDER=mock
# TTS options: google | mock
TTS_PROVIDER=mock

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (client/.env)
# Only variables prefixed with VITE_ are exposed to the browser client.
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_APP_NAME=Uzhavan 360
VITE_APP_TAGLINE=Connecting Farms, Nourishing Lives
VITE_DEFAULT_LANGUAGE=en
